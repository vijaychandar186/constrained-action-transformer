{
  "description": "Stockfish-reward RL on the large model, then identical-position evaluation and 100 color-swapped games against the frozen supervised model.",
  "stages": [
    {
      "name": "sample_training_positions",
      "command": [
        "python",
        "-m",
        "src.rl_positions",
        "--data",
        "data/large",
        "--output",
        "runs/large_rl/training_positions.json",
        "--count",
        "4096",
        "--seed",
        "314"
      ],
      "artifacts": [
        "runs/large_rl/training_positions.json"
      ],
      "timeout_seconds": 600
    },
    {
      "name": "stockfish_rl",
      "command": [
        "python",
        "-m",
        "src.rl_train",
        "--checkpoint",
        "runs/large/checkpoints/pretrain.pth",
        "--positions",
        "runs/large_rl/training_positions.json",
        "--positions-json",
        "--group-size",
        "4",
        "--output",
        "runs/large_rl/checkpoints/rl.pth",
        "--steps",
        "512",
        "--batch-size",
        "4",
        "--depth",
        "8",
        "--learning-rate",
        "0.000003",
        "--kl-weight",
        "0.2",
        "--max-kl",
        "0.1",
        "--seed",
        "314",
        "--resume",
        "--require-cuda"
      ],
      "artifacts": [
        "runs/large_rl/checkpoints/rl.pth",
        "runs/large_rl/checkpoints/rl/metrics.json"
      ],
      "timeout_seconds": 5400
    },
    {
      "name": "evaluate_reference",
      "command": [
        "python",
        "-m",
        "src.evaluate",
        "--checkpoint",
        "runs/large/checkpoints/pretrain.pth",
        "--positions",
        "runs/full/checkpoints/pretrain/validation.pgn",
        "--output",
        "runs/large_rl/reference_acpl.json",
        "--count",
        "512",
        "--depth",
        "8",
        "--seed",
        "42",
        "--require-cuda"
      ],
      "artifacts": [
        "runs/large_rl/reference_acpl.json"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "evaluate_rl",
      "command": [
        "python",
        "-m",
        "src.evaluate",
        "--checkpoint",
        "runs/large_rl/checkpoints/rl.pth",
        "--positions",
        "runs/full/checkpoints/pretrain/validation.pgn",
        "--output",
        "runs/large_rl/rl_acpl.json",
        "--count",
        "512",
        "--depth",
        "8",
        "--seed",
        "42",
        "--require-cuda"
      ],
      "artifacts": [
        "runs/large_rl/rl_acpl.json"
      ],
      "timeout_seconds": 900
    },
    {
      "name": "rl_vs_reference",
      "command": [
        "python",
        "-m",
        "src.compare",
        "--candidate",
        "runs/large_rl/checkpoints/rl.pth",
        "--candidate-name",
        "Large + Stockfish RL",
        "--baseline",
        "runs/large/checkpoints/pretrain.pth",
        "--baseline-name",
        "Large supervised reference",
        "--positions",
        "runs/full/checkpoints/pretrain/validation.pgn",
        "--output",
        "runs/large_rl/matches.json",
        "--pairs",
        "50",
        "--max-plies",
        "200",
        "--seed",
        "123",
        "--acpl",
        "runs/large_rl/reference_acpl.json",
        "runs/large_rl/rl_acpl.json",
        "--require-cuda"
      ],
      "artifacts": [
        "runs/large_rl/matches.json",
        "runs/large_rl/matches.pgn"
      ],
      "timeout_seconds": 1800
    }
  ]
}
