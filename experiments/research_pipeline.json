{
  "description": "Follow-up experiments on common held-out positions after the full pipeline.",
  "stages": [
    {
      "name": "prepare_all",
      "command": [
        "python",
        "-m",
        "src.prepare_data",
        "--source",
        "https://database.lichess.org/standard/lichess_db_standard_rated_2026-04.pgn.zst",
        "--output",
        "data/lichess_all.pgn",
        "--max-games",
        "20000",
        "--min-elo",
        "0",
        "--max-elo",
        "4000",
        "--exclude-pgn",
        "runs/full/checkpoints/pretrain/validation.pgn"
      ],
      "artifacts": [
        "data/lichess_all.pgn"
      ],
      "timeout_seconds": 3600
    },
    {
      "name": "train_all",
      "command": [
        "python",
        "-m",
        "src.train",
        "data/lichess_all.pgn",
        "--output",
        "runs/research/all.pth",
        "--validation-pgn",
        "runs/full/checkpoints/pretrain/validation.pgn",
        "--epochs",
        "3",
        "--require-cuda",
        "--resume"
      ],
      "artifacts": [
        "runs/research/all.pth"
      ],
      "timeout_seconds": 5400
    },
    {
      "name": "evaluate_all",
      "command": [
        "python",
        "-m",
        "src.evaluate",
        "--checkpoint",
        "runs/research/all.pth",
        "--positions",
        "runs/full/checkpoints/pretrain/validation.pgn",
        "--output",
        "runs/research/all_acpl.json",
        "--require-cuda"
      ],
      "artifacts": [
        "runs/research/all_acpl.json"
      ],
      "timeout_seconds": 1800
    },
